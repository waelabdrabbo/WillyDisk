			<string>%lld عناصر من القائمة الأقدم ليست في القائمة الأحدث.</string>
			<key>many</key>
			<string>%lld عنصرًا من القائمة الأقدم ليس في القائمة الأحدث.</string>
			<key>one</key>
			<string>عنصر واحد من القائمة الأقدم ليس في القائمة الأحدث.</string>
			<key>other</key>
