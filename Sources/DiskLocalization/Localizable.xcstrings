    "Export Diagnostics writes scan settings, timing, issue counts, and the app version. It carries no file names, paths, or contents.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتب «تصدير التشخيصات» إعدادات الفحص والتوقيت وأعداد المشكلات وإصدار التطبيق، ولا يتضمّن أسماء الملفات ولا مساراتها ولا محتوياتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Diagnostics writes scan settings, timing, issue counts, and the app version. It carries no file names, paths, or contents."
