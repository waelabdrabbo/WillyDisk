			<string>lld</string>
			<key>few</key>
			<string>%lld عناصر في القائمة الأحدث عند حد القطع أو دونه، لذا لا تُقارن.</string>
			<key>many</key>
			<string>%lld عنصرًا في القائمة الأحدث عند حد القطع أو دونه، لذا لا يُقارن.</string>
