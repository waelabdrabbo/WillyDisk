      },
      "shouldGenerateSwiftSymbol": false
    },
    "A possible duplicate is only a same-size candidate. Check Contents reads the files and compares SHA-256 digests; only matching contents are listed as identical, and cancelling the check confirms nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكرار المحتمل ليس إلا مرشحًا بالحجم نفسه. «فحص المحتويات» يقرأ الملفات ويقارن ملخصات SHA-256؛ ولا تُدرج كمطابقة إلا المحتويات المتطابقة، وإلغاء الفحص لا يؤكد شيئًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A possible duplicate is only a same-size candidate. Check Contents reads the files and compares SHA-256 digests; only matching contents are listed as identical, and cancelling the check confirms nothing."
          }
        },
        "en-XA": {
          "stringUnit": {
            "state": "translated",
            "value": "[Á þöššíƀļé ðúþļíçáŧé íš öñļý á šáɱé-šížé çáñðíðáŧé. Çĥéçķ Çöñŧéñŧš ŕéáðš ŧĥé ƒíļéš áñð çöɱþáŕéš ŠĤÁ-256 ðíĝéšŧš; öñļý ɱáŧçĥíñĝ çöñŧéñŧš áŕé ļíšŧéð áš íðéñŧíçáļ, áñð çáñçéļļíñĝ ŧĥé çĥéçķ çöñƒíŕɱš ñöŧĥíñĝ.·········································································································································································································]"
          }
        }
      },
      "shouldGenerateSwiftSymbol": false
    },
