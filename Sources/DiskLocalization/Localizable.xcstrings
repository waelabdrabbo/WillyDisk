    "Paths that are hard links to another file are not offered as copies, because moving one frees nothing until every link is gone: %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسارات التي هي روابط صلبة لملف آخر لا تُعرض نُسخًا، لأن نقل أحدها لا يحرّر شيئًا حتى تزول كل الروابط: %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
